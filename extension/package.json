{
  "name": "veil-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VEIL browser extension: local perception, redaction and action execution",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "wxt prepare",
    "models": "node scripts/models.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
